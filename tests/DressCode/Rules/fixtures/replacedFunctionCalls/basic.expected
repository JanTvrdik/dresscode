<?php
// {"api": {"replacedCalls": {"utf8_encode($string)": {"write": "mb_convert_encoding($string, 'UTF-8', 'ISO-8859-1')", "because": "a build without mbstring answers the call with an error"}, "acme_close($handle)": "removed", "acme_pad($text, $length)": "str_pad($text, $length, ' ', STR_PAD_LEFT)", "acme_pad($text, $length, true)": "str_pad($text, $length)", "Acme\\Text\\slug($text)": "Acme\\Text\\slugify($text, '-')"}}}
// risky

// the template says what may go wrong
$a = mb_convert_encoding($text, 'UTF-8', 'ISO-8859-1');

// a call doing nothing goes with its statement, and is only reported where its value is used
$b = acme_close($handle);

// the key whose arguments have the more specific shape decides
$c = str_pad($text, 3, ' ', STR_PAD_LEFT);
$d = str_pad($text, 3);

// a function of a namespace, by its whole name
$e = \Acme\Text\slugify($title, '-');

// a callable has no arguments to write
$f = utf8_encode(...);
